# Copy this file to .env and fill in real values locally. Never commit .env.
# All variables here are validated by src/infrastructure/config/environments.ts —
# the app will fail to start if a required one is missing.

PORT=3000
REDIS_URL=
DATABASE_URL=
BOT_TOKEN=
BOT_TOKEN_TEST=
MAINTAINER_CHAT_ID=
TIME_ZONE=Europe/Kyiv
RAILWAY_PUBLIC_DOMAIN=localhost
LOG_LEVEL=debug
LOG_LEVEL_HTTP=debug
NODE_ENV=development
STUDIO_ID=
STUDIO_ID_TEST=
GOOGLE_PLACE_ID=
AI_API_KEY=
AI_MODEL_STANDARD=
AI_DAILY_CALL_LIMIT=
TRANSCRIPTION_SHARED_SECRET=
TRANSCRIPTION_SERVICE_URL=

# Shared secret required via the `x-api-key` header on every REST endpoint
# except GET /api/v1/health. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=
